' Revision: ax removal (2026-10-27).
title Artifact ownership, transport and cleanup boundaries
skinparam componentStyle rectangle

package "CURRENT interactive API - SPEC 0.5.1-draft" {
  folder "Launcher config - persistent\ncontract owner: curator-run\nfile identity: configuration-directory owner" as config {
    artifact "launcher.json / selector.json / session-managers.json\nhost / selector / registry policy" as activeconfig
    artifact "Retired ax.json sentinel\nall four locations; existence only\nrefuse ax_tracking_removed" as retired
    artifact "defaults.json\nmodel / effort / permissions\noperator first unless machine lock" as defaults
  }
  folder "Curator-owned persistent context" as context {
    artifact "Profile / lock / current selection" as profile
    folder "Managed home\nmarker-recorded prompt / MCP surfaces\nCurator materializes / repairs / garbage collects" as home
  }
  folder "curator-run - caller identity\ntransient invocation buffers" as launcher {
    artifact "Closed fragment v1 / v2 / v3 / v4\nCCJ-1 digest; profile pin\nreserved path_prepend remains non-operative" as fragment
    artifact "Admitted / composed plan value\nBinary / Argv / Env / Stdin / WorkDir\nno provider session state" as plan
    artifact "Optional native network snapshot\nprivate read-only evaluated executable\nprocess owner stages and executes same bytes" as snapshot
  }
  component "curator env resolve --repair\ncaller-side subprocess" as curator
  component "Native provider child\ncaller-side identity" as native
  artifact "Selected session-manager plugin\nlaunch-delegated/1 request / attach\nmanager-owned session state" as receiver
  config --> launcher : validated reads; unsafe / failed read refuses, never absence
  profile --> curator : resolve selected profile / pin
  curator --> home : repair ownership; launcher never writes
  curator --> fragment : closed JSON stdout; foreign stderr preserved
  fragment --> plan : context channels / owned env / metadata
  home --> launcher : late Codex layer / prompt read probes only
  plan --> native : full composed env / cwd / argv / exact stdin
  fragment --> receiver : delegated profile / digest request; manager composes\nterminal attach uses private fd3 / status fd4
  config --> receiver : FRONT-DOOR 3-5 / 5.8 selection and capability checks
  snapshot --> native : optional admitted direct network scope
  note bottom of launcher
    [[../SPEC.md#47-the-launchers-configuration-file-family SPEC 4.7]] / [[../SPEC.md#41-obtain-the-fragment-context-plane SPEC 4.1]] / [[../SPEC.md#45-compose-the-launch SPEC 4.5]] / [[../SPEC.md#46-hand-off-and-exec SPEC 4.6]] / [[../SPEC.md#49-hosted-payload-and-receiver-handoff SPEC 4.9]].
    Missing / unreadable Codex layer refuses; retry starts a new Curator repair.
    Payload / config / channel failure never silently drops metadata.
    Invocation buffers / descriptors are not persistent session state.
    Exact native snapshot removal: unspecified in spec 4.4b; delegated hosting follows FRONT-DOOR 3-5 / 5.8.
    Auto without manager: native + notice; explicit hosted refuses session_host_missing with reason.
  end note
}

package "TARGET one-shot - NOT IMPLEMENTED; dispatcher Slice 0 local headless" {
  artifact "Caller-owned immutable composed plan\nprofile pin / approved harness identity / effective env / PATH\nprotected tools -> admitted base PATH -> protected dispatcher\nno repository .agents/bin; digest covers PATH / workspace / exec profile / resources" as immutable
  folder "Dispatcher-owned persistent execution state\nUnix-socket service from first slice" as dispatchstate {
    artifact "Host admission permit\nsession-scoped: one logical_session_id\nsession lifecycle authorisation member unpublished" as hostpermit
    artifact "Claims / run and effect IDs\nrequest / agent / execution IDs remain distinct\nper-operation retry reuses its own effect ID" as claims
    artifact "Outcome / helper termination evidence\nnot inferred from caller / sudo exit" as outcome
  }
  artifact "Admitted base B tree archive\ncaller supplies; dispatcher relays / journals digest\narchive format unpublished" as basearchive
  component "swarma-workspace-materialize\napproved executor, child UID\ndispatcher workspace contract" as materialize
  component "swarma-workspace-export\napproved executor, child UID\nfixed environment / no network; only after confirmed absence" as export
  artifact "swarma-dispatcher workspace-result/1\nchange set only; dispatcher draft fields\ntransport / caps / retention and activation gated" as result
  component "Board change-request machinery\nrecompute manifest from repository B; check result base_commit / manifest_digest\ndeterministic import / exact C review / rework / signed fast-forward" as changes
  folder "Agent-owned cross-account workspace" as workspace {
    artifact "Standalone repository at admitted exact base\nprivate .git / common directory / refs / index / fresh config; no hooks\nfresh local configuration; no hooks / remotes / credential helpers" as repository
  }
  folder "Root user-manager / launcher-owned state" as rootstate {
    artifact "Generation ledger\nroot-owned 0644, root-owned directory\nactive (uid,generation); no secrets" as ledger
    artifact "Approved executor / active owned home checks\nprotected machine exec-policy identity / body digest pin\nclass / qualified host / admission checks" as approved
    artifact "Atomic start receipt BEFORE UID drop\nexecution_id / epoch / pid / start_time / boot_id / session_id\nattempt identity, not readiness" as startreceipt
  }
  component "swarma-user-launcher\nroot process; no-argument sudo entry" as root
  artifact "Privileged stdin request\n80 KiB / 5 s; base64 plan 64 KiB\nother helper 16 KiB / 5 s\ndispatcher service frame 128 KiB" as request
  artifact "Read-only FD3 = decoded plan only, 48 KiB\ncaller-owned 0-2 only otherwise; no service / broker / root handle\nprefer completely staged bounded immutable bytes\nmechanism jointly unpublished; user-manager owns lifecycle" as planfd
  component "curator-run exec adapter\nagent UID worker-<label>\nbounded immutable read / verify" as executor
  folder "Broker-owned persistent state" as brokerstate {
    artifact "Protected credential_binding/1\npeer uid / generation, profile, harness, account, channel\nendpoint, harness SHA-256, policy generation\nrandom binding_id and generation never reused" as binding
    artifact "Credential store\nfiles 0600; owner-only directories 0700\nKeychain / Secret Service later" as store
  }
  component "swarma-credential-broker\nservice UID unspecified in spec 10.3\nfresh peer-authenticated connection / 64 KiB frames" as broker
  artifact "works.relux.curator.credential/1\nrequired-understanding METADATA ONLY\nmode / account / channel; no material" as metadata
  artifact "Execution-scoped leased material\nqualified channel only\nnever plan / argv / files / logs / receipts" as material
  component "Admitted harness\nagent-side process\nSlice 0 Claude token env channel" as harness
  artifact "Consumed-plan / credential evidence\ndigest + qualified executor + policy generation\nno secrets; wire / storage unpublished" as consumed
  hostpermit --> claims : host_start: per-start (execution_id, controller_epoch, op_id) interlock\nsuccessor needs authorisation / prior absence; idempotent (logical_session_id, op_id)
  basearchive --> materialize : exact path / kind-mode / content against immutable manifest\nmissing / extra / mismatch refuses before work
  materialize --> repository : fresh standalone repository; no hooks / remotes
  immutable --> materialize : admitted B / mode-aware manifest / write scope / exec-policy pin
  outcome --> export : account-wide absence; workplace write fence
  repository --> export : walk without following links; ignore worker Git history
  export --> result : compare mode AND content; mode-only / file-symlink modify\ndeletions prior mode; bounded whole-export refusals
  result --> changes : dispatcher journals digests; original caller only; board accepts resource
  immutable --> request : dispatcher admits smallest applicable bound before provisioning
  request --> root : closed privileged request on stdin
  ledger --> root : active generation / ownership checks
  approved --> root : executor / home checks; apply pinned exec profile\nverify policy body digest before any child code; drift refuses
  root --> startreceipt : atomic write; existing receipt refuses second start
  root --> planfd : user-manager lifecycle; bounded plan staging
  planfd --> executor : after clear groups / GID / UID drop; no alternate intake
  immutable --> metadata : metadata within admitted plan
  metadata --> executor : no endpoint / executable / material selection by profile bytes
  ledger --> broker : bind / lease / renew active principal check
  binding --> executor : destination-local check before lease AND harness execution
  executor --> broker : selected broker source; digest is launch_id correlation only
  store --> broker : broker is sole rotating-account refresh owner
  broker --> material : qualified / authorised execution-scoped lease
  material --> harness : executor injects only admitted release-qualified channel
  executor --> harness : verify and execute plan values; no repair / compose / defaults
  executor --> consumed : required evidence; transport unspecified in spec 10.4
  consumed --> outcome : dispatcher owns record; not stdout or start receipt substitution
  note right of broker
    [[../SPEC.md#103-broker-binding-credential-delivery-and-rollout SPEC 10.3]]:
    unreadable / missing / retired / ambiguous ledger refuses.
    revoked caller chain blocks new leases / renewals.
    source conflict / unqualified injection / binding mismatch refuses;
    no native login fallback. Harness can read its own token.
    Native per-home is separate: source-policy v1 absence means per-home;
    v2 requires explicit source; read failure never means absence.
    Later Codex: external token to per-session app-server,
    no launch auth.json / broker-mode codex exec; qualification pending.
    Muse priority decided; channel proposed; qualification open; API-key lane separate.
  end note
  note bottom of dispatchstate
    [[../SPEC.md#104-signals-stop-receipts-and-cleanup SPEC 10.4]]:
    owned helper exec.stop verifies latest receipt identity; replayed stop never signals;
    user-manager spec 4.4 / 4.7 single scope: all UID processes, TERM / grace / KILL;
    stop per-user service domain where present; account-wide quiet absence before claim release / replacement.
    Old receipt cannot stop successor; receipt time does not filter the process set.
    Process fate table / replaced-daemon writer fence: user-manager spec 7 (R-FATE).
    host_stop under permit: configured host only, journaled E-stop / confirmed absence;
    host-requested, distinct from owner cancel; no start authority.
    Dispatcher unbinds then retires, each effect confirmed separately.
    Separate one-shot identity revocation only after retirement;
    standing identity revocation is operator-only.
    After quiesce / declared-key cleanup and recorded export or operator waiver, delete home.
    R-TRANSFER workspace export recorded or operator-waived before home deletion.
    Separate retirement metadata export: service-generated closed schema only.
    Separate operator home retention carries no confidentiality guarantee.
    Executor owns neither retirement nor identity revocation.
    R-TIME: authenticated / operator-controlled installer time source; durable dispatcher / broker watermark.
    Expiry max(now, watermark); not_before min(now, watermark); no untrusted advance; operator reset.
    Expiry-driven home / binding destruction also requires boot-inclusive monotonic elapsed lifetime.
  end note
  note right of workspace
    [[../SPEC.md#102-caller-dispatcher-privileged-launcher-and-executor SPEC 10.2]] / [[../SPEC.md#105-typed-refusals-exit-status-and-activation-questions SPEC 10.5]].
    No inherited .git backlink, executable local configuration or credential helpers.
    Copy / reflink preserves private writable Git administration; no mutable hard-linked metadata.
    Linked worktrees only within one account, including existing board workflow.
    Optional shared objects: immutable, read-only to agents, authorised source objects only.
    R-TRANSFER materialization / export: dispatcher workspace contract, approved child-UID executors.
    Board resource -> deterministic import -> exact C review -> existing signed fast-forward.
    Transfer formats and shared-object provenance / access / retention remain open.
    No weakened home permissions / recursive privileged chown / new privileged workspace service.
    Admitted base and accepted results do not prove secret-free content.
  end note
  note bottom of executor
    [[../SPEC.md#101-immutable-input-descriptor-transport-and-limits SPEC 10.1]] / [[../SPEC.md#102-caller-dispatcher-privileged-launcher-and-executor SPEC 10.2]] / [[../SPEC.md#105-typed-refusals-exit-status-and-activation-questions SPEC 10.5]].
    FD3 mechanism publication gates activation with intake / digest / framing / read deadline.
    Pipe would need qualified capacity / feeder / deadline / cleanup order.
    Lifecycle reference: user-manager spec 7 and diagrams/launch.puml (R-FD3).
    Intake envelope / digest placement / dedicated argv: unspecified in spec 10.1.
    Post-exec receipt transport and renewal / release ownership: unspecified in spec 10.4.
    Numeric refusal exits / signal encoding: unspecified in spec 10.5.
    Unknown process evidence is not success or permission to release capacity.
    Agent home lifecycle: dispatcher via helper; materialization / export: dispatcher's workspace contract (R-TRANSFER).
    SH2 host_start / permit publication, helper signatures and donor B remain open.
    No long-session state / resume / remote capability added by this diagram.
  end note
}
note right of immutable
  Launch obligations - SPEC 10.1-10.2 / 10.5-10.6
  R-TRANSFER: plan digest covers B / mode-aware manifest digest / write scope / pinned exec-profile identity and body digest.
  Manifest from immutable B: path / Git kind-mode / content identity; archive exact-match before work.
  Export compares mode and content: mode-only / equal-blob file-symlink modify; deletion prior mode.
  Board import recomputes canonical manifest from repository B, never plan; base_commit / manifest_digest must match.
  R-EXEC selection: protected machine policy beside R-NETBIND; profile-lock / placement / class bound.
  Dispatcher pins at prepare; launch / retry / recovery use pin; out-of-bound request or drift refuses.
  Launcher verifies policy body digest before any child code; existing class / host / qualification checks remain.
  R-NET-TOOL: read-only task resources covered by digest; bound provider proxy only.
  No web by default; plan disables provider-side search, invisible to network rules.
  Only operator-granted trusted-circle opt-in: qualified server search or platform Unix-socket web service.
  R-STANDING: verify settings / hooks / MCP / instructions by digest before exec, or root-owned surfaces.
  Drift refuses (code unpublished); repair is explicit re-materialization.
  Plan / root-owned surfaces alone do not exclude ambient candidate discovery (SPEC 10.2).
  R-STANDING: host loop requires trusted class AND local agent placement; circle membership is insufficient.
  Remote identities receive workplaces only; donor-side loops; circle does not change placement.
  Optional local-only reviewer / requester-exclusion policies remain unchosen and off (SPEC 9).
  OPEN requirement (SPEC 9): bridge / helper / dispatcher, stage A, jointly publish ingress / relay /
  start / quiesce / export / reconnect lifetime and generation-bound process-creation fence.
  Full fix with stage A contract package; no mechanism selected or normative change shown.
  R-EXEC: qualify full invocation / env / transitive interpreted code-config inputs; inert inspection only.
  Protected entrypoints / config, disabled or pinned code loading; executable allowlist alone is insufficient.
  Negative scripts / inline eval / imports / plugins / startup-env injection / direct-indirect heavy bypass; inert positive controls.
  D-PATH wrapper ownership / fixed subcommand alone is insufficient; unprovable local tool goes to R-VERIFY.
  User manager owns OS exec allowlist; R-VERIFY builds / tests / code execution on another machine.
  R-UNTRUSTED refused in Slice 0 / user-manager v0; workplace zero egress / donor-side loop.
  Admission: R-CEILINGS / R-WATCH / R-ALLSTOP / R-RANGE-DENY / R-SOCKETS / R-SHARED (SPEC 10.6).
  Exact plan / transfer / opt-in formats and qualification remain open; no implementation claimed.
end note
note right of changes
  R-TRANSFER review - SPEC 10.2
  Explicit review-role grant: trusted-class local agent placement or person admitted to role;
  outside untrusted class and distinct from producer; circle alone grants no role / placement.
  Exact-C diffs / blobs first: inert read-only resources by digest, outside harness discovery roots.
  Candidate instructions / hooks / MCP / permissions / skills / executable discovery remain data.
  No automatic adoption at startup / reload / nested discovery / resume / child entry,
  before or after acknowledgement; record shows no preceding load; every flagged hunk acknowledged.
  Discovery-capable tree entry requires a qualified strict-context adapter before launch.
  Qualification covers hook / MCP / instruction / skill on each real harness tool path; none loaded / executed.
  Root-owned surfaces alone do not exclude ambient discovery. No qualification claimed.
  Acceptance is not control-surface admission; separate CIP-0002 admission required.
  Semantic prompt injection remains a review residual.
end note
