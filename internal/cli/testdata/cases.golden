# env only
args: ["codex_cli"]
result: env="codex_cli" native=[]

# env with empty native tail
args: ["codex_cli" "--"]
result: env="codex_cli" native=[]

# native tail verbatim
args: ["codex_cli" "--profile" "companyA" "--" "resume" "--last"]
result: env="codex_cli" profile="companyA" native=["resume" "--last"]

# native tail keeps empty operand
args: ["pi" "--" "" "hello" ""]
result: env="pi" native=["" "hello" ""]

# native tail keeps colliding launcher flags
args: ["claude_code" "--" "--profile" "x" "--model" "m" "--help" "-h" "--version"]
result: env="claude_code" native=["--profile" "x" "--model" "m" "--help" "-h" "--version"]

# native tail keeps second double dash
args: ["claude_code" "--" "--" "a" "--"]
result: env="claude_code" native=["--" "a" "--"]

# native tail keeps stray operands
args: ["codex_cli" "--" "one" "two" "three"]
result: env="codex_cli" native=["one" "two" "three"]

# native tail keeps unknown flags
args: ["codex_cli" "--" "--no-such-flag" "--dangerously-bypass"]
result: env="codex_cli" native=["--no-such-flag" "--dangerously-bypass"]

# flags before env
args: ["--profile" "companyA" "--model" "gpt-5.3-codex" "codex_cli"]
result: env="codex_cli" profile="companyA" model="gpt-5.3-codex" native=[]

# flags after env
args: ["codex_cli" "--model" "gpt-5.3-codex" "--effort" "high"]
result: env="codex_cli" model="gpt-5.3-codex" effort="high" native=[]

# equals form
args: ["codex_cli" "--profile=companyA" "--effort=medium"]
result: env="codex_cli" profile="companyA" effort="medium" native=[]

# equals form value containing equals
args: ["codex_cli" "--profile=a=b"]
result: env="codex_cli" profile="a=b" native=[]

# permissions native separate
args: ["codex_cli" "--permissions" "native"]
result: env="codex_cli" permissions="native" native=[]

# permissions yolo separate
args: ["codex_cli" "--permissions" "yolo"]
result: env="codex_cli" permissions="yolo" native=[]

# permissions native equals
args: ["--permissions=native" "codex_cli"]
result: env="codex_cli" permissions="native" native=[]

# permissions yolo equals
args: ["--permissions=yolo" "codex_cli"]
result: env="codex_cli" permissions="yolo" native=[]

# yolo alias
args: ["--yolo" "codex_cli"]
result: env="codex_cli" permissions="yolo" native=[]

# native tail keeps permission spellings
args: ["pi" "--" "--permissions" "yolo" "--yolo" "-d" "--danger"]
result: env="pi" native=["--permissions" "yolo" "--yolo" "-d" "--danger"]

# system prompt append
args: ["pi" "--system-prompt" "append"]
result: env="pi" system-prompt=append native=[]

# system prompt replace
args: ["pi" "--system-prompt" "replace"]
result: env="pi" system-prompt=replace native=[]

# network separated
args: ["codex_cli" "--network" "egress-a"]
result: env="codex_cli" network="egress-a" native=[]

# network equals
args: ["codex_cli" "--network=egress-a"]
result: env="codex_cli" network="egress-a" native=[]

# network before env
args: ["--network" "egress-a" "codex_cli"]
result: env="codex_cli" network="egress-a" native=[]

# native tail keeps network flag
args: ["codex_cli" "--" "--network" "egress-a"]
result: env="codex_cli" native=["--network" "egress-a"]

# help alone
args: ["--help"]
result: info=help

# short help alone
args: ["-h"]
result: info=help

# version alone
args: ["--version"]
result: info=version

# help after valid flags wins
args: ["codex_cli" "--profile" "p" "--help"]
result: info=help

# version after env wins
args: ["codex_cli" "--version" "--unknown-never-read"]
result: info=version

# help before version: first wins
args: ["--help" "--version"]
result: info=help

# version before help: first wins
args: ["--version" "--help"]
result: info=version

# help without env-id
args: ["--model" "m" "-h"]
result: info=help

# env-id lookalike is not validated here
args: ["not_registered"]
result: env="not_registered" native=[]

# alias claude normalizes to claude_code
args: ["claude"]
result: env="claude_code" native=[]

# alias codex normalizes to codex_cli
args: ["codex"]
result: env="codex_cli" native=[]

# alias claude with flags and native tail
args: ["claude" "--profile" "p" "--" "resume" "--last"]
result: env="claude_code" profile="p" native=["resume" "--last"]

# alias codex with flags before env
args: ["--model" "m" "codex"]
result: env="codex_cli" model="m" native=[]

# native tail alias spellings untouched
args: ["pi" "--" "claude" "codex"]
result: env="pi" native=["claude" "codex"]

# hosted flag
args: ["claude_code" "--hosted"]
result: env="claude_code" host=--hosted native=[]

# native flag
args: ["claude_code" "--native"]
result: env="claude_code" host=--native native=[]

# untracked flag
args: ["claude_code" "--untracked"]
result: env="claude_code" host=--untracked native=[]

# host flag before env
args: ["--hosted" "claude_code" "--" "x"]
result: env="claude_code" host=--hosted native=["x"]

# resume latest selector
args: ["claude_code" "resume"]
result: env="claude_code" resume native=[]

# resume handle selector
args: ["claude_code" "resume" "SES-abc123"]
result: env="claude_code" resume handle="SES-abc123" native=[]

# resume selector with flags interleaved
args: ["claude_code" "--hosted" "resume" "--model" "m" "SES-1" "--" "x"]
result: env="claude_code" host=--hosted resume handle="SES-1" model="m" native=["x"]

# resume flag
args: ["claude_code" "--hosted" "--resume" "01234567-89ab-cdef-0123-456789abcdef"]
result: env="claude_code" host=--hosted resume-id="01234567-89ab-cdef-0123-456789abcdef" native=[]

# resume flag equals form
args: ["claude_code" "--resume=abc"]
result: env="claude_code" resume-id="abc" native=[]

# network flag
args: ["claude_code" "--network" "office"]
result: env="claude_code" network="office" native=[]

# network flag equals form
args: ["claude_code" "--network=office"]
result: env="claude_code" network="office" native=[]

# native tail keeps host and resume spellings
args: ["pi" "--" "--hosted" "--native" "--untracked" "resume" "--resume" "x" "--network" "y"]
result: env="pi" native=["--hosted" "--native" "--untracked" "resume" "--resume" "x" "--network" "y"]

# no arguments
args: []
error: usage: missing <env-id>

# only double dash
args: ["--"]
error: usage: missing <env-id>

# flags only no env
args: ["--profile" "p"]
error: usage: missing <env-id>

# native tail no env
args: ["--" "codex_cli"]
error: usage: missing <env-id>

# empty env operand
args: [""]
error: usage: empty operand before --: <env-id> must not be empty

# stray operand
args: ["codex_cli" "frobnicate"]
error: usage: stray operand "frobnicate" before --: native arguments must follow --

# stray operand then double dash
args: ["codex_cli" "frobnicate" "--" "x"]
error: usage: stray operand "frobnicate" before --: native arguments must follow --

# second operand after resume handle
args: ["codex_cli" "resume" "SES-1" "extra"]
error: usage: stray operand "extra" before --: native arguments must follow --

# second resume token is a handle
args: ["codex_cli" "resume" "resume" "extra"]
error: usage: stray operand "extra" before --: native arguments must follow --

# unknown flag
args: ["codex_cli" "--nope"]
error: usage: unknown flag "--nope" before --

# unknown flag equals form
args: ["codex_cli" "--nope=1"]
error: usage: unknown flag "--nope=1" before --

# unknown single dash flag
args: ["codex_cli" "-p" "x"]
error: usage: unknown flag "-p" before --

# lone dash
args: ["codex_cli" "-"]
error: usage: unknown flag "-" before --

# unknown flag before help
args: ["--nope" "--help"]
error: usage: unknown flag "--nope" before --

# triple dash
args: ["codex_cli" "---"]
error: usage: unknown flag "---" before --

# repeated profile
args: ["codex_cli" "--profile" "a" "--profile" "b"]
error: usage: flag --profile given more than once

# repeated model mixed forms
args: ["codex_cli" "--model=a" "--model" "b"]
error: usage: flag --model given more than once

# repeated effort
args: ["codex_cli" "--effort" "a" "--effort" "a"]
error: usage: flag --effort given more than once

# repeated permissions
args: ["codex_cli" "--permissions=native" "--permissions" "yolo"]
error: usage: --permissions and --yolo are one permission request and cannot be repeated or combined

# permissions and yolo alias
args: ["codex_cli" "--permissions" "native" "--yolo"]
error: usage: --permissions and --yolo are one permission request and cannot be repeated or combined

# yolo alias and permissions
args: ["codex_cli" "--yolo" "--permissions=yolo"]
error: usage: --permissions and --yolo are one permission request and cannot be repeated or combined

# yolo alias equals value
args: ["codex_cli" "--yolo=true"]
error: usage: --yolo is an alias without a value

# unknown permissions mode
args: ["codex_cli" "--permissions=automatic"]
error: usage: --permissions accepts native or yolo, got "automatic"

# unknown permissions mode separate
args: ["codex_cli" "--permissions" "auto"]
error: usage: --permissions accepts native or yolo, got "auto"

# legacy short danger
args: ["codex_cli" "-d"]
error: usage: -d is rejected; use --permissions native or --permissions yolo

# legacy short danger equals
args: ["codex_cli" "-d=true"]
error: usage: -d is rejected; use --permissions native or --permissions yolo

# legacy danger
args: ["codex_cli" "--danger"]
error: usage: --danger is rejected; use --permissions native or --permissions yolo

# legacy danger equals
args: ["codex_cli" "--danger=true"]
error: usage: --danger is rejected; use --permissions native or --permissions yolo

# repeated system prompt
args: ["pi" "--system-prompt" "append" "--system-prompt" "replace"]
error: usage: flag --system-prompt given more than once

# repeated name
args: ["codex_cli" "--name" "a" "--name" "b"]
error: usage: --name was removed in 0.6.0

# repeated ax profile
args: ["codex_cli" "--ax-profile" "yolo" "--ax-profile" "standard"]
error: usage: --ax-profile was removed in 0.6.0

# repeated network
args: ["codex_cli" "--network" "a" "--network" "b"]
error: usage: flag --network given more than once

# repeated network mixed forms
args: ["codex_cli" "--network=a" "--network" "b"]
error: usage: flag --network given more than once

# network missing value at end
args: ["codex_cli" "--network"]
error: usage: flag --network requires a value

# network missing value before double dash
args: ["codex_cli" "--network" "--" "x"]
error: usage: flag --network requires a value

# network missing value equals empty
args: ["codex_cli" "--network="]
error: usage: flag --network requires a value, got ""

# network value spelled as flag
args: ["codex_cli" "--network" "--model" "m"]
error: usage: flag --network requires a value, got "--model"

# missing value at end
args: ["codex_cli" "--profile"]
error: usage: flag --profile requires a value

# missing value before double dash
args: ["codex_cli" "--model" "--" "x"]
error: usage: flag --model requires a value

# missing value equals empty
args: ["codex_cli" "--profile="]
error: usage: flag --profile requires a value, got ""

# missing value empty string
args: ["codex_cli" "--effort" ""]
error: usage: flag --effort requires a value, got ""

# value spelled as flag
args: ["codex_cli" "--profile" "--model" "m"]
error: usage: flag --profile requires a value, got "--model"

# value is help flag
args: ["codex_cli" "--name" "--help"]
error: usage: --name was removed in 0.6.0

# system prompt bad value
args: ["pi" "--system-prompt" "prepend"]
error: usage: --system-prompt accepts append or replace, got "prepend"

# system prompt case sensitive
args: ["pi" "--system-prompt" "Append"]
error: usage: --system-prompt accepts append or replace, got "Append"

# system prompt without value
args: ["pi" "--system-prompt"]
error: usage: flag --system-prompt requires a value

# ax profile bad value tracked
args: ["codex_cli" "--ax-profile" "unsafe"]
error: usage: --ax-profile was removed in 0.6.0

# ax profile bad value untracked
args: ["codex_cli" "--ax-profile" "unsafe"]
error: usage: --ax-profile was removed in 0.6.0

# ax profile case sensitive
args: ["codex_cli" "--ax-profile" "YOLO"]
error: usage: --ax-profile was removed in 0.6.0

# ax profile on untracked machine
args: ["codex_cli" "--ax-profile" "standard"]
error: usage: --ax-profile was removed in 0.6.0

# ax profile yolo on untracked machine
args: ["codex_cli" "--ax-profile" "yolo"]
error: usage: --ax-profile was removed in 0.6.0

# name 65 chars
args: ["codex_cli" "--name" "abbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"]
error: usage: --name was removed in 0.6.0

# name leading dot
args: ["codex_cli" "--name" ".hidden"]
error: usage: --name was removed in 0.6.0

# name leading underscore
args: ["codex_cli" "--name" "_x"]
error: usage: --name was removed in 0.6.0

# name with slash
args: ["codex_cli" "--name" "a/b"]
error: usage: --name was removed in 0.6.0

# name with space
args: ["codex_cli" "--name" "a b"]
error: usage: --name was removed in 0.6.0

# name with unicode
args: ["codex_cli" "--name" "сессия"]
error: usage: --name was removed in 0.6.0

# name with newline
args: ["codex_cli" "--name" "a\nb"]
error: usage: --name was removed in 0.6.0

# name invalid on untracked machine still rejected
args: ["codex_cli" "--name" "bad/name"]
error: usage: --name was removed in 0.6.0

# repeated hosted flag
args: ["claude_code" "--hosted" "--hosted"]
error: usage: --hosted, --native and --untracked share one host request and cannot be repeated or combined

# repeated native flag
args: ["claude_code" "--native" "--native"]
error: usage: --hosted, --native and --untracked share one host request and cannot be repeated or combined

# hosted native combination
args: ["claude_code" "--hosted" "--native"]
error: usage: --hosted, --native and --untracked share one host request and cannot be repeated or combined

# native untracked combination
args: ["claude_code" "--native" "--untracked"]
error: usage: --hosted, --native and --untracked share one host request and cannot be repeated or combined

# untracked hosted combination
args: ["claude_code" "--untracked" "--hosted"]
error: usage: --hosted, --native and --untracked share one host request and cannot be repeated or combined

# hosted flag with value
args: ["claude_code" "--hosted=yes"]
error: usage: --hosted takes no value

# native flag with value
args: ["claude_code" "--native=no"]
error: usage: --native takes no value

# repeated resume flag
args: ["claude_code" "--resume" "a" "--resume" "b"]
error: usage: flag --resume given more than once

# resume flag missing value
args: ["claude_code" "--resume"]
error: usage: flag --resume requires a value

# resume flag empty value
args: ["claude_code" "--resume" ""]
error: usage: flag --resume requires a value, got ""

# repeated network flag
args: ["claude_code" "--network" "a" "--network" "b"]
error: usage: flag --network given more than once

# network flag missing value
args: ["claude_code" "--network"]
error: usage: flag --network requires a value

# ax profile with native flag
args: ["codex_cli" "--ax-profile" "standard" "--native"]
error: usage: --ax-profile was removed in 0.6.0

# ax profile with untracked flag
args: ["codex_cli" "--untracked" "--ax-profile" "yolo"]
error: usage: --ax-profile was removed in 0.6.0

