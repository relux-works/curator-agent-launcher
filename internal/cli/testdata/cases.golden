# untracked flag
args: ["claude_code" "--untracked"]
ax: false
result: env="claude_code" tracked=false host=--untracked native=[]

# host flag before env
args: ["--hosted" "claude_code" "--" "x"]
ax: false
result: env="claude_code" tracked=false host=--hosted native=["x"]

# resume latest selector
args: ["claude_code" "resume"]
ax: false
result: env="claude_code" tracked=false resume native=[]

# resume handle selector
args: ["claude_code" "resume" "SES-abc123"]
ax: false
result: env="claude_code" tracked=false resume handle="SES-abc123" native=[]

# resume selector with flags interleaved
