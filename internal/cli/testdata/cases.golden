ax: false
result: env="claude_code" tracked=false host=--hosted resume handle="SES-1" model="m" native=["x"]

# resume flag
args: ["claude_code" "--hosted" "--resume" "01234567-89ab-cdef-0123-456789abcdef"]
ax: false
result: env="claude_code" tracked=false host=--hosted resume-id="01234567-89ab-cdef-0123-456789abcdef" native=[]

# resume flag equals form
args: ["claude_code" "--resume=abc"]
ax: false
result: env="claude_code" tracked=false resume-id="abc" native=[]

# network flag
args: ["claude_code" "--network" "office"]
ax: false
result: env="claude_code" tracked=false network="office" native=[]

# network flag equals form
args: ["claude_code" "--network=office"]
ax: false
result: env="claude_code" tracked=false network="office" native=[]

# native tail keeps host and resume spellings
args: ["pi" "--" "--hosted" "--native" "--untracked" "resume" "--resume" "x" "--network" "y"]
ax: false
result: env="pi" tracked=false native=["--hosted" "--native" "--untracked" "resume" "--resume" "x" "--network" "y"]

