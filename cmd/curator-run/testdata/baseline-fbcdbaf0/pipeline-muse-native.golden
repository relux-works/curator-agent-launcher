{
  "Argv": [
    "--model",
    "muse-spark-1.3-contributor",
    "--reasoning-effort",
    "max",
    "--workspace",
    "<ROOT>"
  ],
  "Env": [
    "HOME=<ROOT>",
    "MUSE_NO_AUTO_UPDATE=1",
    "PATH=<ROOT>",
    "XDG_CACHE_HOME=<ROOT>/managed/cache",
    "XDG_CONFIG_HOME=<ROOT>/managed/config",
    "XDG_DATA_HOME=<ROOT>/managed/data",
    "XDG_STATE_HOME=<ROOT>/managed/state"
  ],
  "Stdin": "cGFyZW50IHN0ZGluCgD/",
  "WorkDir": "<ROOT>"
}
