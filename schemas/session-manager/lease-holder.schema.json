{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relux:curator-run:lease-holder-v1",
  "title": "Home leases v1: holder",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "launcher",
    "manager_id",
    "manager_registered_at",
    "request_id",
    "werkstatt",
    "session",
    "generation",
    "process"
  ],
  "properties": {
    "kind": {
      "enum": [
        "prepared",
        "bound"
      ]
    },
    "launcher": {
      "const": "curator-run"
    },
    "manager_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "manager_registered_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,9})?Z$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "werkstatt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "session": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "process": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pid",
            "started_at"
          ],
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "started_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,9})?Z$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "prepared"
          }
        }
      },
      "then": {
        "properties": {
          "session": {
            "type": "null"
          },
          "generation": {
            "type": "null"
          },
          "process": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "session": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "process": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pid",
              "started_at"
            ],
            "properties": {
              "pid": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "started_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,9})?Z$"
              }
            }
          }
        }
      }
    }
  ]
}
