{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relux:curator-run:lease-holder-v1",
  "title": "Home leases v1: holder 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "launcher",
    "manager_id",
    "manager_registered_at",
    "request_id",
    "werkstatt",
    "session",
    "generation",
    "process"
  ],
  "properties": {
    "kind": {
      "enum": [
        "prepared",
        "bound"
      ]
    },
    "launcher": {
      "const": "curator-run"
    },
    "manager_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
    },
    "manager_registered_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,9})?Z$(?![\\s\\S])"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
    },
    "werkstatt": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "session": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "process": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pid",
            "started_at"
          ],
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "started_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,9})?Z$(?![\\s\\S])"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "uid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967294
            },
            "boot_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
            },
            "start_time": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "linux-stat-starttime"
                    },
                    "ticks": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]{0,19})$(?![\\s\\S])"
                    },
                    "hz": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    }
                  },
                  "required": [
                    "kind",
                    "ticks",
                    "hz"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "darwin-pbi-start"
                    },
                    "sec": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]{0,19})$(?![\\s\\S])"
                    },
                    "usec": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 999999
                    }
                  },
                  "required": [
                    "kind",
                    "sec",
                    "usec"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "pid",
            "uid",
            "boot_id",
            "start_time"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "prepared"
          }
        }
      },
      "then": {
        "properties": {
          "session": {
            "type": "null"
          },
          "generation": {
            "type": "null"
          },
          "process": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pid",
                  "started_at"
                ],
                "properties": {
                  "pid": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "started_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,9})?Z$(?![\\s\\S])"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "session": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$(?![\\s\\S])"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "process": {
            "type": "object",
            "properties": {
              "pid": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "uid": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967294
              },
              "boot_id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])"
              },
              "start_time": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "linux-stat-starttime"
                      },
                      "ticks": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,19})$(?![\\s\\S])"
                      },
                      "hz": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000
                      }
                    },
                    "required": [
                      "kind",
                      "ticks",
                      "hz"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "darwin-pbi-start"
                      },
                      "sec": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,19})$(?![\\s\\S])"
                      },
                      "usec": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 999999
                      }
                    },
                    "required": [
                      "kind",
                      "sec",
                      "usec"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "pid",
              "uid",
              "boot_id",
              "start_time"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
