{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relux:curator-run:describe",
  "title": "describe 1.0.0",
  "type": "object",
  "properties": {
    "protocol": {
      "const": "curator-session-manager/1"
    },
    "ok": {
      "const": true
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]{1,64}$"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "runtimes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9_]{1,64}$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "enum": [
            "launch",
            "launch-exact",
            "resume",
            "attach",
            "status",
            "cancel",
            "list",
            "stop"
          ]
        },
        "uniqueItems": true
      }
    }
  },
  "required": [
    "protocol",
    "ok",
    "id",
    "version",
    "capabilities",
    "runtimes"
  ],
  "additionalProperties": false
}
