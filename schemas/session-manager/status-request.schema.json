{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relux:curator-run:status-request",
  "title": "status-request 1.0.0",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "pattern": "^SES-[A-Za-z0-9]{1,48}$"
        }
      },
      "required": [
        "session"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "operation_id"
      ],
      "additionalProperties": false
    }
  ]
}
