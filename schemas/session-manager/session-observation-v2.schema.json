{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relux:curator-run:session-observation-v2",
  "title": "curator-run-session-observation-v2",
  "type": "object",
  "properties": {
    "schema": {
      "const": "curator-run-session-observation-v2"
    },
    "manager": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "executable": {
          "type": "string",
          "pattern": "^/[^\u0000]*$"
        },
        "registered_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-]00:00)$",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "executable",
        "registered_at"
      ],
      "additionalProperties": false
    },
    "session": {
      "$ref": "urn:relux:curator-run:session-record"
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "process_observation": {
          "type": "boolean"
        }
      },
      "required": [
        "process_observation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "manager",
    "session",
    "observed_at",
    "capabilities"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "capabilities": {
            "properties": {
              "process_observation": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "session": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "process"
                  ]
                },
                {
                  "required": [
                    "termination"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
