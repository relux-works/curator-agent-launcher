{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relux:curator-run:werkstatt-record-v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "role": {
      "enum": [
        "developer",
        "reviewer",
        "orchestrator"
      ]
    },
    "runtime": {
      "enum": [
        "claude_code",
        "codex_cli",
        "muse",
        "pi",
        "opencode"
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$"
        }
      ]
    },
    "effort": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$"
        }
      ]
    },
    "weights_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^gguf-sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "profile": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9_-])?$",
          "maxLength": 128
        },
        {
          "not": {
            "type": "string",
            "pattern": "^([cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])([.]|$)"
          }
        }
      ]
    },
    "clone": {
      "type": "string",
      "pattern": "^/[^\u0000]*$"
    },
    "git_dir": {
      "type": "string",
      "pattern": "^/[^\u0000]*$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-z0-9._=-]{1,64}$"
    },
    "room": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\u0000-\u001f]+$"
    },
    "orchestrator": {
      "type": "string",
      "pattern": "^[a-z0-9._=-]{1,64}$"
    },
    "context_mode": {
      "enum": [
        "continue",
        "fresh"
      ]
    },
    "harness_memory": {
      "type": "boolean"
    },
    "sandbox": {
      "enum": [
        "none",
        "workspace-write"
      ]
    },
    "child_env": {
      "$ref": "urn:relux:curator-run:child-env-v1"
    },
    "trust_class": {
      "type": "string"
    },
    "doorbell": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "heartbeat": {
              "type": "string",
              "pattern": "^([3-9][0-9]s|[1-9][0-9]{2}s|[12][0-9]{3}s|3[0-5][0-9]{2}s|3600s|[1-9]m|[1-5][0-9]m|60m)$"
            },
            "max_wakes_per_hour": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          },
          "required": [
            "heartbeat",
            "max_wakes_per_hour"
          ],
          "additionalProperties": false
        }
      ]
    },
    "config_decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$"
    },
    "schema": {
      "const": "werkstatt-record-v1"
    }
  },
  "required": [
    "id",
    "project",
    "role",
    "runtime",
    "model",
    "effort",
    "profile",
    "clone",
    "identity",
    "room",
    "orchestrator",
    "sandbox",
    "trust_class",
    "doorbell",
    "schema"
  ],
  "additionalProperties": false
}
