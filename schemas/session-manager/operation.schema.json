{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relux:curator-run:werkstatt-operation-v1",
  "title": "werkstatt-operation-v1 1.1.0",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "kind": {
      "enum": [
        "launch",
        "resume"
      ]
    },
    "submitted_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "admission_key": {
      "anyOf": [
        {
          "anyOf": [
            {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^werkstatt:[a-z0-9][a-z0-9-]{0,47}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "manager": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "executable": {
          "type": "string",
          "pattern": "^/[^\u0000]*$"
        },
        "registered_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "executable",
        "registered_at"
      ],
      "additionalProperties": false
    },
    "profile": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]*[A-Za-z0-9_-])?$",
          "maxLength": 128
        },
        {
          "not": {
            "type": "string",
            "pattern": "^([cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9]|[lL][pP][tT][1-9])([.]|$)"
          }
        }
      ]
    },
    "phase": {
      "enum": [
        "lease_requested",
        "lease_prepared",
        "possibly_submitted",
        "bind_pending"
      ]
    },
    "cwd": {
      "type": "string",
      "pattern": "^/[^\u0000]*$"
    },
    "request": {
      "oneOf": [
        {
          "$ref": "urn:relux:curator-run:delegated-launch"
        },
        {
          "$ref": "urn:relux:curator-run:delegated-resume"
        }
      ]
    },
    "lease": {
      "type": "object",
      "required": [
        "request_id",
        "route",
        "environment",
        "lock_sha256",
        "holder",
        "capabilities",
        "operations",
        "record"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "route": {
          "const": "delegated"
        },
        "environment": {
          "enum": [
            "claude_code",
            "codex_cli",
            "muse"
          ]
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "holder": {
          "allOf": [
            {
              "$ref": "urn:relux:curator-run:lease-holder-v1"
            },
            {
              "properties": {
                "kind": {
                  "const": "prepared"
                }
              }
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "record": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:relux:curator-run:lease-record-v1"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "operation_id",
    "kind",
    "submitted_at",
    "admission_key",
    "manager"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "phase"
        ]
      },
      "then": {
        "required": [
          "profile",
          "cwd",
          "request",
          "lease"
        ]
      },
      "else": {
        "properties": {
          "admission_key": {
            "type": "string"
          },
          "cwd": {
            "not": {}
          },
          "request": {
            "not": {}
          },
          "lease": {
            "not": {}
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "phase"
        ],
        "properties": {
          "phase": {
            "enum": [
              "lease_prepared",
              "possibly_submitted",
              "bind_pending"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "lease": {
            "properties": {
              "record": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "phase"
        ],
        "properties": {
          "kind": {
            "const": "launch"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "urn:relux:curator-run:delegated-launch"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "phase"
        ],
        "properties": {
          "kind": {
            "const": "resume"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "urn:relux:curator-run:delegated-resume"
          }
        }
      }
    }
  ]
}
