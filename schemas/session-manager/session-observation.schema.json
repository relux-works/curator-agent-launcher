{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relux:curator-run:session-observation",
  "title": "curator-run-session-observation-v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "curator-run-session-observation-v1"
    },
    "manager": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        },
        "executable": {
          "type": "string",
          "pattern": "^/[^\u0000]*$"
        },
        "registered_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-]00:00)$",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "executable",
        "registered_at"
      ],
      "additionalProperties": false
    },
    "session": {
      "$ref": "urn:relux:curator-run:session-record"
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    }
  },
  "required": [
    "schema",
    "manager",
    "session",
    "observed_at"
  ],
  "additionalProperties": false
}
