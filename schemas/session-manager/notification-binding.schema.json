{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relux:curator-run:notification-binding",
  "title": "notification-binding 1.0.0",
  "type": "object",
  "properties": {
    "execution": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$"
    },
    "controller_epoch": {
      "type": "string",
      "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "description": "Canonical nonzero decimal uint64 string, at most18446744073709551615."
    },
    "runner_instance": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$"
    },
    "native_thread": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$"
    },
    "member_ref": {
      "$ref": "urn:relux:curator-run:notification-ref"
    },
    "connection_ref": {
      "$ref": "urn:relux:curator-run:notification-short-ref"
    },
    "configuration_ref": {
      "$ref": "urn:relux:curator-run:notification-ref"
    },
    "profile_lock_ref": {
      "$ref": "urn:relux:curator-run:notification-ref"
    },
    "consumer_generation": {
      "$ref": "urn:relux:curator-run:notification-short-ref"
    },
    "enrollment_ref": {
      "$ref": "urn:relux:curator-run:notification-ref"
    },
    "workflow_reference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/@+-]{1,128}$"
    },
    "workflow_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "execution",
    "controller_epoch",
    "runner_instance",
    "native_thread",
    "member_ref",
    "connection_ref",
    "configuration_ref",
    "profile_lock_ref",
    "consumer_generation",
    "enrollment_ref",
    "workflow_reference",
    "workflow_sha256"
  ],
  "additionalProperties": false
}
